APP_NAME=Noteverse
BACKEND_PORT=8000
# Directory sul filesystem host; dentro il container è sempre /app/data.
HOST_DATA_DIR=./backend/data
NEO4J_IMAGE=neo4j:5.26-community
NEO4J_USER=neo4j
NEO4J_PASSWORD=noteverse-local-change-me
NEO4J_DATABASE=neo4j
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_CONNECTION_TIMEOUT=5
CORS_ORIGINS=["http://localhost:3000"]
